<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rapport_9421_historique_tree" model="ir.ui.view">
        <field name="name">rapport.9421.historique.list</field>
        <field name="model">rapport.9421.historique</field>
        <field name="arch" type="xml">
            <list string="Historique des générations" decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="annee"/>
                <field name="company_id"/>
                <field name="date_generation"/>
                <field name="user_id"/>
                <field name="nb_employes"/>
                <field name="state"
                       decoration-success="state == 'ok'"
                       decoration-danger="state == 'error'"
                       widget="badge"/>
                <button name="action_telecharger"
                        string="Télécharger PDF"
                        type="object"
                        icon="fa-download"
                        invisible="not attachment_id"/>
            </list>
        </field>
    </record>

    <record id="rapport_9421_historique_form" model="ir.ui.view">
        <field name="name">rapport.9421.historique.form</field>
        <field name="model">rapport.9421.historique</field>
        <field name="arch" type="xml">
            <form string="Détail génération" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="annee"/>
                            <field name="company_id"/>
                            <field name="nb_employes"/>
                        </group>
                        <group string="Traçabilité">
                            <field name="date_generation"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group string="Erreur" invisible="state != 'error'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <group string="Fichier">
                        <field name="attachment_id" invisible="not attachment_id"/>
                    </group>
                    <footer invisible="not attachment_id">
                        <button name="action_telecharger"
                                string="Télécharger le PDF"
                                type="object"
                                class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rapport_9421_historique" model="ir.actions.act_window">
        <field name="name">Historique des générations</field>
        <field name="res_model">rapport.9421.historique</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_rapport_9421_root"
              name="Rapport 9421"
              parent="payroll.payroll_menu_root"
              sequence="99"/>

    <menuitem id="menu_rapport_9421_generer"
              name="Générer Rapport 9421"
              parent="menu_rapport_9421_root"
              action="action_wizard_rapport_9421"
              sequence="10"/>

    <menuitem id="menu_rapport_9421_historique"
              name="Historique des générations"
              parent="menu_rapport_9421_root"
              action="action_rapport_9421_historique"
              sequence="20"/>

</odoo>