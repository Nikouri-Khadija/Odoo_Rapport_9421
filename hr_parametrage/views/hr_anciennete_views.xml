<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue Liste -->
    <record id="view_hr_anciennete_list" model="ir.ui.view">
        <field name="name">hr.anciennete.list</field>
        <field name="model">hr.anciennete</field>
        <field name="arch" type="xml">
            <list string="Barème Ancienneté" editable="bottom">
                <field name="debut_tranche" string="Début Tranche (années)"/>
                <field name="fin_tranche"   string="Fin Tranche (années)"/>
                <field name="taux"          string="Taux (%)"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire -->
    <record id="view_hr_anciennete_form" model="ir.ui.view">
        <field name="name">hr.anciennete.form</field>
        <field name="model">hr.anciennete</field>
        <field name="arch" type="xml">
            <form string="Tranche Ancienneté">
                <sheet>
                    <group>
                        <field name="debut_tranche" string="Début Tranche (années)"/>
                        <field name="fin_tranche"   string="Fin Tranche (années)"/>
                        <field name="taux"          string="Taux (%)"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_anciennete" model="ir.actions.act_window">
        <field name="name">Ancienneté</field>
        <field name="res_model">hr.anciennete</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une première tranche d'ancienneté
            </p>
            <p>Configurez les tranches d'ancienneté et leurs taux.</p>
        </field>
    </record>

</odoo>
